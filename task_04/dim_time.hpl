<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_time2</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/29 18:15:39.670</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/29 18:15:39.670</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Generate rows</from>
      <to>Create sequence</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create sequence</from>
      <to>Join rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join rows (cartesian product)</from>
      <to>Keep only year column</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep only year column</from>
      <to>Compute decade from year</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Tables input</from>
      <to>Join rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compute decade from year</from>
      <to>DIM_TIME lookup/update</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Compute decade from year</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formulas>
      <formula>
        <field_name>decade</field_name>
        <formula>[year] - MOD([year], 10)</formula>
        <set_na>N</set_na>
        <value_length>4</value_length>
        <value_precision>-1</value_precision>
        <value_type>5</value_type>
      </formula>
    </formulas>
    <attributes/>
    <GUI>
      <xloc>782</xloc>
      <yloc>140</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Create sequence</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <increment_by>1</increment_by>
    <max_value>10000</max_value>
    <seqname>SEQ_</seqname>
    <start_at>0</start_at>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <valuename>year</valuename>
    <attributes/>
    <GUI>
      <xloc>203</xloc>
      <yloc>143</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Generate rows</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>tmp</name>
        <nullif>10</nullif>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>Integer</type>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>10000</limit>
    <never_ending>N</never_ending>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>48</xloc>
      <yloc>143</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Join rows (cartesian product)</name>
    <type>JoinRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>500</cache_size>
    <compare>
      <condition>
        <conditions>
          <condition>
            <conditions>
</conditions>
            <function>&gt;=</function>
            <leftvalue>year</leftvalue>
            <negated>N</negated>
            <operator>-</operator>
            <rightvalue>min_year</rightvalue>
          </condition>
          <condition>
            <conditions>
</conditions>
            <function>&lt;=</function>
            <leftvalue>year</leftvalue>
            <negated>N</negated>
            <operator>AND</operator>
            <rightvalue>max_year</rightvalue>
          </condition>
        </conditions>
        <function>&gt;=</function>
        <leftvalue>year</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <rightvalue>min_year</rightvalue>
      </condition>
    </compare>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <attributes/>
    <GUI>
      <xloc>391</xloc>
      <yloc>141</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Keep only year column</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-2</length>
        <name>year</name>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>583</xloc>
      <yloc>141</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Tables input</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT MIN(year) AS min_year, MAX(year) AS max_year
FROM (SELECT year
	  FROM stagingDB.HISTORICAL_EVENTS
	  UNION
	  SELECT year
	  FROM stagingDB.MADDISON_INDICATORS
	  UNION
	  SELECT year
	  FROM stagingDB.WDI_INDICATORS) AS tmp</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>389</xloc>
      <yloc>16</yloc>
    </GUI>
  </transform>
  <transform>
    <name>DIM_TIME lookup/update</name>
    <type>CombinationLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>9999</cache_size>
    <commit>100</commit>
    <connection>Staging</connection>
    <crc>N</crc>
    <crcfield>hashcode</crcfield>
    <fields>
      <key>
        <lookup>year</lookup>
        <name>year</name>
      </key>
      <key>
        <lookup>decade</lookup>
        <name>decade</name>
      </key>
      <return>
        <creation_method>tablemax</creation_method>
        <last_update_field/>
        <name>time_id</name>
        <use_autoinc>N</use_autoinc>
      </return>
    </fields>
    <preloadCache>N</preloadCache>
    <replace>N</replace>
    <schema>datawarehouseDB</schema>
    <table>DIM_TIME</table>
    <attributes/>
    <GUI>
      <xloc>975</xloc>
      <yloc>140</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
