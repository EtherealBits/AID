    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT * FROM
(SELECT * FROM MADDISON_INDICATORS
WHERE indicator_code = 'gdp' OR 
      indicator_code = 'gdppc'
UNION
SELECT * FROM WDI_INDICATORS
WHERE indicator_code = 'NY.GDP.MKTP.KD.ZG' OR
	  indicator_code = 'NE.EXP.GNFS.ZS' OR
      indicator_code = 'NE.IMP.GNFS.ZS') AS tmp
ORDER BY country_name, indicator_code;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>64</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
