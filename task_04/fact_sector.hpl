    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT country_name, year, indicator_code, value
FROM WDI_INDICATORS
WHERE indicator_code = 'NV.AGR.TOTL.ZS' OR
	  indicator_code = 'NV.AGR.TOTL.CD' OR
      indicator_code = 'NV.IND.TOTL.ZS' OR
      indicator_code = 'NV.IND.TOTL.CD' OR
      indicator_code = 'NV.IND.MANF.ZS' OR
      indicator_code = 'NV.IND.MANF.CD' OR
      indicator_code = 'NV.SRV.TOTL.ZS' OR
      indicator_code = 'NV.SRV.TOTL.CD' OR
      indicator_code = 'SL.AGR.EMPL.ZS' OR
      indicator_code = 'SL.IND.EMPL.ZS' OR
      indicator_code = 'SL.SRV.EMPL.ZS';</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>48</xloc>
      <yloc>64</yloc>
    </GUI>
